---
import { ArrowUpRight, ArrowDownLeft } from 'lucide-astro';
---

<section>
    <h1>Jasa Pembuatan Website Terbaik di Indonesia</h1>
    <p>Sudah termasuk design, copywriting, domain, hosting, dan maintenance bulanan. </p>
    <div class="cta">
        <a href="/">Konsultasi Gratis <ArrowUpRight/></a>
        <a href="#keunggulan">Lihat Keunggulan <ArrowDownLeft/></a>
    </div>
    <img
        src="/images/jasa-pembuatan-website-terbaik-di-indonesia.webp"
        alt="Jasa Pembuatan Website Terbaik di Indonesia"
        width="1920"
        height="1080"
    >
</section>

<style>

    section{
        padding: 64px 0;
    }

    h1,p{
        text-align:center;
        max-width:800px;
        margin:0 auto;
    }

    p{
        margin: 16px auto;
        color: var(--muted);
    }

    .cta{
        display:flex;
        justify-content:center;
        align-items:center;
        gap:32px;
        margin-top:32px;
    }

    a{
        color:inherit;
        text-decoration:none;
        padding: 8px 16px;
        display:flex;
        justify-content:center;
        align-items:center;
        gap:16px;
        font-size:14px;
        font-weight:500;
    }

    .cta a:nth-of-type(1){
        background-color: var(--accent);
        color: #ffffff;
        border-radius:4px;
    }

    .cta a:nth-of-type(2){
        border-bottom: 1px solid #101010;
        color: #101010;
        padding: 8px 0
    }

    img{
        width:100%;
        height:auto;
        display:block;
        border-radius:20px;
        margin-top:64px;
    }
</style>


