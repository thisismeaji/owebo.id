---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SinglePost from '../../components/SinglePost.astro';
import PostGrid from '../../components/PostGrid.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
	const postPaths = posts.map((post) => ({
		params: { slug: post.id.split('/').pop() ?? post.id },
		props: { type: 'post', post, posts },
	}));
	const categoryMap = new Map<string, string>();

	posts.forEach((post) => {
		categoryMap.set(post.data.categorySlug, post.data.category);
	});

	const categoryPaths = Array.from(categoryMap.entries()).map(([categorySlug, category]) => ({
		params: { slug: categorySlug },
		props: { type: 'category', category, posts },
	}));

	return [...postPaths, ...categoryPaths];
}

const { type, post, category, posts } = Astro.props;
const Content = type === 'post' && post ? (await render(post)).Content : undefined;
const categoryPosts = type === 'category'
	? posts
		.filter((entry) => entry.data.categorySlug === Astro.params.slug)
		.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
	: [];
const siteUrl = 'https://owebo.id';
const postUrl = post ? new URL(post.data.canonicalPath, siteUrl).toString() : '';
const postImageUrl = post ? new URL(post.data.image, siteUrl).toString() : '';
const articleSchema = post ? {
	'@type': 'BlogPosting',
	'@id': `${postUrl}#blogposting`,
	url: postUrl,
	name: post.data.title,
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': `${postUrl}#webpage`,
	},
	headline: post.data.title,
	description: post.data.metaDescription,
	image: {
		'@type': 'ImageObject',
		url: postImageUrl,
		contentUrl: postImageUrl,
		caption: post.data.imageAlt,
		width: post.data.imageWidth,
		height: post.data.imageHeight,
		creditText: 'Owebo',
		creator: {
			'@type': 'Organization',
			name: 'Owebo',
		},
		copyrightNotice: 'Owebo',
	},
	datePublished: post.data.publishedAt.toISOString(),
	dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
	author: {
		'@type': 'Person',
		name: post.data.author,
		jobTitle: post.data.authorRole,
	},
	publisher: {
		'@type': 'Organization',
		'@id': `${siteUrl}/#organization`,
		name: 'Owebo',
		url: siteUrl,
		logo: {
			'@type': 'ImageObject',
			url: `${siteUrl}/images/logo.png`,
			contentUrl: `${siteUrl}/images/logo.png`,
			width: 512,
			height: 512,
			caption: 'Logo Owebo',
			creditText: 'Owebo',
			creator: {
				'@type': 'Organization',
				name: 'Owebo',
			},
			copyrightNotice: 'Owebo',
		},
	},
	isPartOf: {
		'@id': `${siteUrl}/blog#blog`,
	},
	articleSection: post.data.category,
	keywords: post.data.keywords.join(', '),
	inLanguage: 'id-ID',
} : undefined;
const categoryUrl = `${siteUrl}/blog/${Astro.params.slug}`;
const categorySchema = type === 'category' ? [
	{
		'@type': 'ItemList',
		'@id': `${categoryUrl}#post-list`,
		name: `Daftar artikel kategori ${category}`,
		itemListElement: categoryPosts.map((entry, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			url: `${siteUrl}/blog/${entry.id.split('/').pop() ?? entry.id}`,
			name: entry.data.title,
		})),
	},
] : undefined;
---

{type === 'post' && post && Content ? (
	<Layout
		title={post.data.metaTitle}
		description={post.data.metaDescription}
		path={post.data.canonicalPath}
		image={post.data.image}
		ogType="article"
		titleSeparator="-"
		titleSuffix="owebo.id"
		breadcrumbs={[
			{ name: 'Beranda', path: '/' },
			{ name: 'Blog', path: '/blog' },
			{ name: post.data.metaTitle, path: post.data.canonicalPath },
		]}
		schema={articleSchema}
	>
		<SinglePost post={post} Content={Content} />
	</Layout>
) : (
	<Layout
		title={`Kategori ${category}`}
		description={`Artikel Owebo dalam kategori ${category}.`}
		path={`/blog/${Astro.params.slug}`}
		image={categoryPosts[0]?.data.image ?? '/images/logo.png'}
		pageType="CollectionPage"
		breadcrumbs={[
			{ name: 'Beranda', path: '/' },
			{ name: 'Blog', path: '/blog' },
			{ name: `Kategori ${category}`, path: `/blog/${Astro.params.slug}` },
		]}
		schema={categorySchema}
	>
		<section class="category-header">
			<span>Kategori</span>
			<h1>{category}</h1>
		</section>
		<PostGrid posts={categoryPosts} />
	</Layout>
)}

<style>
	.category-header{
		margin-bottom: 32px;
	}

	.category-header span{
		display: inline-block;
		margin-bottom: 8px;
		color: var(--muted);
		font-size: 14px;
		font-weight: 500;
	}
</style>
