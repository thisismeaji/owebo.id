---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const postSlug = post.id.split('/').pop() ?? post.id;
const href = `/blog/${postSlug}`;
const categoryHref = `/blog/${post.data.categorySlug}`;
const publishedAt = post.data.publishedAt.toLocaleDateString('id-ID', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});
---

<article>
	<a href={href}>
		<img
			src={post.data.image}
			alt={post.data.imageAlt}
			width={post.data.imageWidth}
			height={post.data.imageHeight}
		>
	</a>
	<div class="meta">
		<time datetime={post.data.publishedAt.toISOString()}>{publishedAt}</time>
		<a href={categoryHref} class="category">{post.data.category}</a>
	</div>
	<h2>
		<a href={href}>{post.data.title}</a>
	</h2>
	<p>{post.data.excerpt}</p>
</article>

<style>

	a{
		color: inherit;
		text-decoration: none;
	}
	img{
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		background-color: var(--border);
		border-radius: 10px;
	}

	.meta{
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 14px;
		font-weight: 400;
		margin: 8px 0;
		color: var(--muted);
	}

	.meta a{
		padding: 4px 16px;
		background-color: var(--border);
		border-radius: 100px;
		font-size: 12px;
		background-image: linear-gradient(currentColor, currentColor);
		background-repeat: no-repeat;
		background-position: center calc(100% - 3px);
		background-size: 0% 1px;
		transition: background-size 0.3s ease-in-out;
	}

	.meta a:hover{
		background-size: calc(100% - 32px) 1px;
	}

	h2{
		font-size: 20px;
		margin-bottom: 8px;
		transition: all 0.3 ease-in-out;
	}

	h2 a{
		position: relative;
		background-image: linear-gradient(var(--accent), var(--accent));
		background-repeat: no-repeat;
		background-position: left bottom;
		background-size: 0% 2px;
		transition: all 0.3s ease-in-out;
	}

	article:hover h2 a{
		color: var(--accent);
		background-size: 100% 2px;
	}

	p{
		line-clamp: 2;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		color: var(--muted);
		font-weight: 400;
	}

	@media screen and (min-width:768px) and (max-width:1024px){
		
	}
	@media screen and (max-width:768px){

	}
</style>
